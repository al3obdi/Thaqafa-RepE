# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---------------------------------------------------------------------------
# IDEs and editors
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Data (tracked placeholders are kept explicitly)
# ---------------------------------------------------------------------------
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ---------------------------------------------------------------------------
# Models, checkpoints and experiment outputs
# ---------------------------------------------------------------------------
checkpoints/
outputs/
runs/
wandb/
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx

# `results/` is deliberately NOT ignored: it holds the committed artefacts of
# experiment runs (manifest, CSVs, report), which are the evidence behind every
# number the paper quotes. `outputs/` is the scratch equivalent for local runs.

# Keep paper result CSVs and Markdown tracked for reproducibility
!outputs/paper_results/
!outputs/paper_results/*.csv
!outputs/paper_results/*.md
# But not large or regeneratable files
outputs/paper_results/vectors.json
outputs/paper_results/figures/*.png
outputs/paper_results/generations/

# ---------------------------------------------------------------------------
# Environment and secrets (the example template stays tracked)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# LaTeX build artefacts (the PDF is regenerated from source)
# ---------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
docs/research_paper/*.log
docs/research_paper/*.pdf

# ---------------------------------------------------------------------------
# OS artifacts
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
